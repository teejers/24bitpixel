# Copy to .env and fill in. See src/wagmi.ts for how these are used.

# WalletConnect (Reown) project ID from dashboard.reown.com. Public, not a secret.
VITE_WALLETCONNECT_ID=

# Which chain this build talks to: hardhat (default) | sepolia | mainnet.
# Usually set per-build (e.g. VITE_CHAIN=sepolia npm run build) rather than here.
#VITE_CHAIN=

# Dedicated RPC endpoint for sepolia/mainnet builds. Falls back to the chain's
# public rate-limited RPC if unset. NOTE: must allow eth_getLogs over the full
# range since deploy — Alchemy's free tier caps it at 10 blocks, which breaks
# the records fetch. PublicNode (ethereum[-sepolia]-rpc.publicnode.com) works.
#VITE_RPC_URL=
