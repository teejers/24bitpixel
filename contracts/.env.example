# Copy to .env and fill in. Loaded by hardhat.config.ts via dotenv.

# Artist wallet: receives the 5% fee on every sale and owns all 24 bits at
# deploy. Immutable once deployed. deploy.ts falls back to the deployer if unset.
ARTIST_ADDRESS=

# RPC endpoint for the sepolia network (Alchemy/Infura HTTPS URL).
SEPOLIA_RPC_URL=

# Private key of the wallet that pays for the deploy transaction. SECRET.
DEPLOYER_PRIVATE_KEY=
